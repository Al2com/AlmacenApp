# Credenciales de docker-compose. Copia este archivo a .env y rellena los valores.
# El .env real NO se sube al repositorio (ver .gitignore).

# --- MySQL ---
# Contraseña de root: solo la usa el contenedor para inicializarse.
MYSQL_ROOT_PASSWORD=
# Base de datos y usuario propio de la aplicación (no root).
MYSQL_DATABASE=almacen
MYSQL_USER=almacen
MYSQL_PASSWORD=

# --- Puertos (se publican solo en 127.0.0.1) ---
DB_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=5173
